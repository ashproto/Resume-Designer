<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Stays OFF. CloudKit does not require the App Sandbox, and the failure
         reports in the field are all sandboxed apps hitting
         `deny mach-lookup com.apple.cloudd`. The loopback bridge and the
         app-support directory both depend on this staying false. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <!-- CloudKit. The container is SHARED with iOS by grant, not by identity:
         two App IDs, one container. Never the default `iCloud.<bundle id>`,
         which would be a different, empty container the app connects to
         cleanly and never sees the phone through. -->
    <key>com.apple.developer.icloud-services</key>
    <array><string>CloudKit</string></array>
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array><string>iCloud.com.onpaper.app</string></array>
    <!-- DEVELOPMENT: this file signs LOCAL builds against the macOS App Development
         provisioning profile, which permits both. Development and
         Production are separate data stores, and the phone's data is in Development. Selected by
         scripts/build-mac-dev.sh through the CLI's config override; never used by CI. -->
    <key>com.apple.developer.icloud-container-environment</key>
    <string>Development</string>
  </dict>
</plist>
